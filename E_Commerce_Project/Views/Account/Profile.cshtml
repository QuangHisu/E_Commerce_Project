@model ProfileForm
@{
    ViewData["Title"] = "Profile";
}
<h1>My profile</h1>
<form asp-action="Profile" method="post" class="form-panel">
    <div asp-validation-summary="All" class="text-danger"></div><label asp-for="FullName" class="form-label">Full
    name</label><input asp-for="FullName" class="form-control mb-3" /><label asp-for="Contact"
                                                                             class="form-label">Pickup contact (email or phone)</label><input asp-for="Contact" class="form-control mb-3" />
    <p>Shared with sellers when you pay for an order. Use fictitious contact details in this demo.</p><button
    class="btn btn-primary">Save profile</button>
</form>