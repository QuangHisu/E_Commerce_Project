@model ForgotPasswordForm
@{
    ViewData["Title"] = "Forgot password";
}
<h1>Forgot password</h1>
<p>Enter your account email to request a password reset link.</p>
<form asp-action="ForgotPassword" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control mb-3"
                                                             autocomplete="email" />
    <button class="btn btn-primary">Send reset link</button>
</form>
<p class="mt-3"><a asp-action="Login">Back to log in</a></p>