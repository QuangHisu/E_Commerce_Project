@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Products";
}
<h1>Products</h1>
<form method="get" class="row g-2 mb-4">
    <div class="col-md-5"><label for="search" class="form-label">Search products</label><input id="search" name="search"
                                                                                                   value="@ViewBag.Search" class="form-control" /></div>
        <div class="col-md-3"><label for="category" class="form-label">Category</label><select id="category" name="category"
                                                                                               class="form-select">
            <option value="">All categories</option>@foreach(var c in new[]{"Stationery","Bags","Desk accessories"}){
            <option value="@c" selected="@(ViewBag.Category == c)">@c</option>
        }
    </select></div>
    <div class="col-md-2"><label for="sort" class="form-label">Sort</label><select id="sort" name="sort"
                                                                                   class="form-select">
        <option value="">Name</option>
        <option value="price" selected="@(ViewBag.Sort == "price")">Price: low</option>
        <option value="price-desc" selected="@(ViewBag.Sort == "price-desc")">Price: high</option>
    </select></div>
    <div class="col-md-2 align-self-end"><button class="btn btn-primary">Search</button></div>
</form>
@if (Model.Count == 0)
{
    <p>No products match your search.</p>
}
<div class="row g-4">@foreach(var p in Model){
    <div class="col-sm-6 col-lg-4">
        <article class="card h-100"><img src="@p.ImageUrl" alt="@p.Name" class="card-img-top product-image" />
            <div class="card-body">
                <h2 class="h5"><a asp-action="Details" asp-route-id="@p.Id">@p.Name</a></h2>
                <p>@p.Category</p>
                <p>CAD @p.Price.ToString("F2") · @p.Stock available</p><a class="btn btn-outline-primary"
                                                                          asp-action="Details" asp-route-id="@p.Id">View product</a>
            </div>
        </article>
    </div>
}
</div>