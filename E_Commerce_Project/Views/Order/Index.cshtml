@model IReadOnlyList<Order>
@{
    ViewData["Title"] = "My orders";
}
<h1>My orders</h1>@if(Model.Count==0){
<p>You have no orders yet.</p>
}
@foreach (var o in Model)
{
    <partial name="_Order" model="o" /><a class="btn btn-outline-primary mb-4" asp-action="Details"
                                          asp-route-id="@o.Id">Order details</a>
}