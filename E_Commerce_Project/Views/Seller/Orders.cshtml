@model IReadOnlyList<Order>
@{
    ViewData["Title"] = "Sales";
}
<h1>Your paid orders</h1>
<p>Only your items and subtotal are shown. Mark orders ready, then completed after pickup.</p>@if(Model.Count==0){
<p>No
    paid orders yet.</p>
}
@foreach (var o in Model)
{
    <partial name="_Order" model="o" />
    var next = o.Items.All(i => i.Status == "Processing") ? "Ready for pickup" : o.Items.All(i => i.Status == "Ready for pickup") ? "Completed" : null; if (next != null)
    {

        <form asp-action="Fulfill" method="post" class="mb-4"><input type="hidden" name="id" value="@o.Id" /><input
            type="hidden" name="status" value="@next" /><button class="btn btn-primary">Mark @next</button></form>
        }
    }
