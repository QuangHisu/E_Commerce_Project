@model ProductForm
@{
    ViewData["Title"] = Model.Id == null ? "Create product" : "Edit product";
}
<h1>@ViewData["Title"]</h1>
<form asp-action="Edit" method="post" enctype="multipart/form-data" class="form-panel">
    <div asp-validation-summary="All" class="text-danger"></div><input asp-for="Id" type="hidden" /><label
    asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control mb-3" /><label
    asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control mb-3"
                                                               rows="4"></textarea><label asp-for="Category" class="form-label"></label><select asp-for="Category"
                                                                                 class="form-select mb-3">
    <option>Stationery</option>
    <option>Bags</option>
    <option>Desk accessories</option>
</select><label asp-for="Price" class="form-label">Price (CAD)</label><input asp-for="Price" type="number"
                                                                             step="0.01" min="0.50" max="10000" class="form-control mb-3" /><label asp-for="Stock"
                                                                      class="form-label">Available stock (excludes reserved orders)</label><input asp-for="Stock" min="0" max="10000"
                                                                            class="form-control mb-3" />
@if (Model.ExistingImage != null)
{
    <img src="@Model.ExistingImage" alt="Current product picture" width="120" class="mb-3" />
}
<label asp-for="Picture" class="form-label d-block">Product picture: PNG or JPEG, up to 2 MB</label><input
asp-for="Picture" type="file" accept="image/png,image/jpeg" class="form-control mb-3" />
<p>A picture is required for a new listing. Leave it empty to keep the current picture.</p><button
class="btn btn-primary">Save product</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>