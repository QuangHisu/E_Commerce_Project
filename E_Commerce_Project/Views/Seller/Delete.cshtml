@model Product
@{
    ViewData["Title"] = "Delete product";
}
<h1>Delete @Model.Name?</h1>
<p>The listing will be removed from the catalogue and carts. Existing order history is preserved.</p>
<form asp-action="Delete" method="post"><input name="id" value="@Model.Id" type="hidden" /><button
    class="btn btn-danger">Delete product</button> <a asp-action="Index" class="btn btn-secondary">Keep product</a>
</form>